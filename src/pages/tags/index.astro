---
import Base from '../../layouts/Base.astro';
import { getEntries } from '../../lib/entries';

const counts = new Map<string, number>();
for (const e of await getEntries()) {
  for (const t of e.data.tags) counts.set(t, (counts.get(t) ?? 0) + 1);
}
const tags = [...counts].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
---

<Base title="Tags">
  <h1 class="section-title">Tags</h1>
  <ul class="tags">
    {
      tags.map(([tag, n]) => (
        <li>
          <a href={`/tags/${tag}`}>
            #{tag} <span class="muted">{n}</span>
          </a>
        </li>
      ))
    }
  </ul>
</Base>

<style>
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tags a {
    display: block;
    padding: 10px 16px;
    border: 1px solid var(--border);
    background: var(--surface);
    font-family: var(--mono);
    font-size: 15px;
    text-decoration: none;
  }

  .tags a:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
</style>
