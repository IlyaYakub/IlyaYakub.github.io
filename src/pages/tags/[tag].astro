---
import Base from '../../layouts/Base.astro';
import EntryGrid from '../../components/EntryGrid.astro';
import { getEntries, type Entry } from '../../lib/entries';

export async function getStaticPaths() {
  const entries = await getEntries();
  const tags = [...new Set(entries.flatMap((e) => e.data.tags))];
  return tags.map((tag) => ({
    params: { tag },
    props: { entries: entries.filter((e) => e.data.tags.includes(tag)) },
  }));
}

const { tag } = Astro.params;
const { entries } = Astro.props as { entries: Entry[] };
---

<Base title={`#${tag}`}>
  <h1 class="section-title">#{tag}</h1>
  <a href="/tags" class="arrow-link back">← All tags</a>
  <EntryGrid entries={entries} />
</Base>

<style>
  .back {
    display: inline-block;
    margin-bottom: 32px;
  }
</style>
