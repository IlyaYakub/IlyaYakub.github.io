---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PairScene from '../../components/PairScene.astro';
import TopicSeries from '../../components/TopicSeries.astro';
import { getEntries, entryTitle, formatDate, projectsFirst, type Entry } from '../../lib/entries';

export async function getStaticPaths() {
  const entries = await getEntries();
  return entries.map((entry) => {
    // the project first, then the oldest first, so the series reads #0, #1, #2, ...
    const series = entry.data.topic ? projectsFirst(entries.filter((e) => e.data.topic === entry.data.topic).reverse()) : [];
    return { params: { id: entry.id }, props: { entry, series } };
  });
}

const { entry, series } = Astro.props as { entry: Entry; series: Entry[] };
const { type, date, tags, url, repo, title, description, cover, topic } = entry.data;
const { Content } = await render(entry);
---

<Base title={entryTitle(entry)} description={description}>
  <div class="layout">
  <article class="entry">
    <div class="meta mono">
      <a href={`/feed/${type}`} class="badge">{type}</a>
      {topic && <a href={`/topic/${topic}`} class="topic">{topic}</a>}
      <span class="muted">{formatDate(date)}</span>
    </div>

    {title && <h1 class="title">{title}</h1>}

    {cover && <img src={cover} alt="" class="cover" />}

    {
      (url || repo) && (
        <div class="links mono">
          {url && (
            <a href={url} rel="noopener">
              {url} ↗
            </a>
          )}
          {repo && (
            <a href={repo} rel="noopener">
              repo ↗
            </a>
          )}
        </div>
      )
    }

    <div class:list={['prose', { 'post-body': !title }]}>
      <Content />
    </div>

    {
      tags.length > 0 && (
        <div class="tags">
          {tags.map((t) => (
            <a href={`/tags/${t}`} class="mono tag">
              #{t}
            </a>
          ))}
        </div>
      )
    }

    <a href="/feed" class="arrow-link back">← Back to feed</a>
  </article>

  <aside class="aside">
    <PairScene />
    {topic && series.length > 0 && <TopicSeries topic={topic} entries={series} currentId={entry.id} />}
  </aside>
  </div>
</Base>

<style>
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 48px;
  }

  .entry {
    min-width: 0;
    max-width: 760px;
  }

  .aside {
    display: flex;
    flex-direction: column;
    gap: 28px;
    max-width: 420px;
  }

  @media (min-width: 1100px) {
    .layout {
      grid-template-columns: minmax(0, 760px) 300px;
      justify-content: space-between;
    }

    .aside {
      position: sticky;
      top: 24px;
      align-self: start;
      padding-top: 52px;
    }
  }

  .meta {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 20px;
  }

  .title {
    margin: 0 0 24px;
    font-size: clamp(36px, 6vw, 64px);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .topic {
    font-weight: 700;
    text-decoration: none;
  }

  .topic:hover {
    color: var(--accent);
  }

  .cover {
    display: block;
    width: 100%;
    height: auto;
    margin-bottom: 32px;
    border: 1px solid var(--border);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    margin-bottom: 32px;
    text-transform: none;
    word-break: break-all;
  }

  .links a {
    color: var(--accent);
  }

  .post-body {
    font-size: 22px;
    line-height: 1.5;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 40px;
    padding-top: 20px;
    border-top: 1px solid var(--border);
  }

  .tag {
    text-transform: none;
    text-decoration: none;
    color: var(--muted);
  }

  .tag:hover {
    color: var(--accent);
  }

  .back {
    display: inline-block;
    margin-top: 40px;
  }
</style>
