---
import Base from '../../layouts/Base.astro';
import EntryGrid from '../../components/EntryGrid.astro';
import FeedFilters from '../../components/FeedFilters.astro';
import { getEntries, getTopics, type Entry } from '../../lib/entries';

export async function getStaticPaths() {
  const all = await getEntries();
  const topics = getTopics(all);
  return topics.map((topic) => ({
    params: { topic },
    props: { topics, entries: all.filter((e) => e.data.topic === topic) },
  }));
}

const { topic } = Astro.params;
const { topics, entries } = Astro.props as { topics: string[]; entries: Entry[] };
---

<Base title={topic}>
  <h1 class="section-title">{topic}</h1>
  <FeedFilters topics={topics} topic={topic} />
  <EntryGrid entries={entries} />
</Base>
