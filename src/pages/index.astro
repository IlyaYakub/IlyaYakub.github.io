---
import Base from '../layouts/Base.astro';
import SectionCard from '../components/SectionCard.astro';
import { getEntries } from '../lib/entries';
import { SITE } from '../consts';

// Every section groups its pages: they are reached only through it.
const all = await getEntries();
const sections = all.filter((e) => e.data.type === 'section');
---

<Base>
  <section class="hero">
    <h1>
      <span>Notes.</span>
      <span>Ideas.</span>
      <span>Projects.</span>
      <span class="hl">&gt; {SITE.name}</span>
    </h1>
    <div class="intro">
      <p>{SITE.description}</p>
      <div class="socials mono">
        {SITE.socials.map((s) => <a href={s.href}>{s.label} →</a>)}
      </div>
    </div>
  </section>

  <section>
    <h2 class="section-title">Sections</h2>
    <div class="sections">
      {sections.map((section) => <SectionCard section={section} entries={all.filter((e) => e.data.topic === section.data.topic && e.id !== section.id)} />)}
    </div>
  </section>
</Base>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    align-items: end;
    gap: 40px;
    padding: 24px 0 72px;
  }

  h1 {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    margin: 0;
    font-size: clamp(48px, 10vw, 120px);
    font-weight: 900;
    line-height: 0.95;
    letter-spacing: -0.035em;
    text-transform: uppercase;
  }

  .hl {
    margin-top: 8px;
    padding: 0 12px 4px;
    background: var(--accent);
    color: #000;
  }

  .intro {
    padding-left: 20px;
    border-left: 2px solid var(--accent);
  }

  .intro p {
    margin: 0 0 20px;
    font-size: 19px;
  }

  .socials {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
  }

  .socials a {
    text-decoration: none;
    color: var(--accent);
  }

  .socials a:hover {
    text-decoration: underline;
  }

  .sections {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 520px), 1fr));
    gap: 16px;
  }

  @media (max-width: 800px) {
    .hero {
      grid-template-columns: 1fr;
      padding-bottom: 48px;
    }
  }
</style>
