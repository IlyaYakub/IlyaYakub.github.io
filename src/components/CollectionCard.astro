---
import type { Entry } from '../lib/entries';

// A card that opens a collection: a project (its sections) or a section (its lessons).
interface Props {
  entry: Entry;
  href: string;
  count: string;
  linkLabel: string;
}

const { entry, href, count, linkLabel } = Astro.props;
const { type, title, description, cover } = entry.data;
---

<a href={href} class="collection">
  {cover && <img src={cover} alt="" class="cover" />}
  <div class="body">
    <div class="meta mono">
      <span class="badge">{type}</span>
      <span class="muted">{count}</span>
    </div>
    <h3 class="title">{title}</h3>
    {description && <p class="desc muted">{description}</p>}
    <span class="arrow-link">{linkLabel} →</span>
  </div>
</a>

<style>
  .collection {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--border);
    background: var(--surface);
    text-decoration: none;
    transition: border-color 0.15s;
  }

  .collection:hover {
    border-color: var(--accent);
  }

  .cover {
    display: block;
    width: 100%;
    height: auto;
    border-bottom: 1px solid var(--border);
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 20px;
  }

  .meta {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .title {
    margin: 0;
    font-size: 32px;
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .desc {
    margin: 0;
    font-size: 15px;
  }
</style>
