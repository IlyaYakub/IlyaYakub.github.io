---
import type { Entry } from '../lib/entries';

interface Props {
  section: Entry;
  entries: Entry[];
}

const { section, entries } = Astro.props;
const { title, description, cover, topic } = section.data;
const href = `/topic/${topic}`;
---

<a href={href} class="section">
  {cover && <img src={cover} alt="" class="cover" />}
  <div class="body">
    <div class="meta mono">
      <span class="badge">section</span>
      <span class="muted">{entries.length} {entries.length === 1 ? 'page' : 'pages'}</span>
    </div>
    <h3 class="title">{title}</h3>
    {description && <p class="desc muted">{description}</p>}
    <span class="arrow-link">Open section →</span>
  </div>
</a>

<style>
  .section {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--border);
    background: var(--surface);
    text-decoration: none;
    transition: border-color 0.15s;
  }

  .section:hover {
    border-color: var(--accent);
  }

  .cover {
    display: block;
    width: 100%;
    height: auto;
    border-bottom: 1px solid var(--border);
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 20px;
  }

  .meta {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .title {
    margin: 0;
    font-size: 32px;
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .desc {
    margin: 0;
    font-size: 15px;
  }
</style>
