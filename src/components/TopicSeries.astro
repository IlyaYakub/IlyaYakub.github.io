---
import { TYPES } from '../consts';
import { entryHref, entryTitle, type Entry } from '../lib/entries';

interface Props {
  topic: string;
  entries: Entry[];
  currentId: string;
}

const { topic, entries, currentId } = Astro.props;

// The section intro is #00, its pages follow from #01.
const offset = entries[0]?.data.type === 'section' ? 0 : 1;
const items = entries.map((entry, index) => ({
  href: entryHref(entry),
  number: String(index + offset),
  name: entryTitle(entry),
  isCurrent: entry.id === currentId,
}));

// "5 notes · 1 section": count each type, so a note is never called a post
const counts = TYPES.map((type) => ({ type, count: entries.filter((e) => e.data.type === type).length }))
  .filter(({ count }) => count > 0)
  .map(({ type, count }) => `${count} ${type}${count === 1 ? '' : 's'}`)
  .join(' · ');
---

<nav class="series" aria-label={`${topic} entries`}>
  <div class="head mono">
    <a href={`/topic/${topic}`} class="name">{topic}</a>
    <span class="muted">{counts}</span>
  </div>
  <ol>
    {
      items.map((item) => (
        <li>
          <a href={item.href} class:list={{ current: item.isCurrent }} aria-current={item.isCurrent ? 'page' : undefined}>
            <span class="number mono">{item.number.padStart(2, '0')}</span>
            <span class="label">{item.name}</span>
          </a>
        </li>
      ))
    }
  </ol>
  <a href={`/topic/${topic}`} class="arrow-link all">All {topic} →</a>
</nav>

<style>
  .series {
    border: 1px solid var(--border);
    background: var(--surface);
  }

  .head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 16px;
    border-bottom: 1px solid var(--border);
  }

  .name {
    color: var(--accent);
    font-weight: 700;
    text-decoration: none;
  }

  ol {
    margin: 0;
    padding: 6px 0;
    list-style: none;
  }

  li a {
    display: flex;
    gap: 12px;
    padding: 7px 16px;
    border-left: 2px solid transparent;
    font-size: 15px;
    line-height: 1.35;
    text-decoration: none;
    color: var(--muted);
  }

  li a:hover {
    color: var(--text);
  }

  li a.current {
    border-left-color: var(--accent);
    background: var(--highlight);
    color: var(--text);
  }

  .label::first-letter {
    text-transform: uppercase;
  }

  .number {
    flex: none;
    color: var(--muted);
    font-size: 12px;
    line-height: 20px;
  }

  .current .number {
    color: var(--accent);
  }

  .all {
    display: block;
    padding: 12px 16px;
    border-top: 1px solid var(--border);
    font-size: 12px;
  }
</style>
